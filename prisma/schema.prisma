generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Meeting {
  id        Int      @id @default(autoincrement())
  title     String
  date      DateTime
  time      String
  location  String
  status    String   @default("Terjadwal")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
